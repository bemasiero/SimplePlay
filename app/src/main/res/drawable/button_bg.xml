<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#1C222A" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2A323D" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
